{
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin/manifest.webmanifest",
      "destination": "/admin.webmanifest"
    },
    {
      "source": "/admin/sw.js",
      "destination": "/admin-sw.js"
    },
    {
      "source": "/admin/config.js",
      "destination": "/config.js"
    },
    {
      "source": "/admin/icons/admin-192.png",
      "destination": "/icons/admin-192.png"
    },
    {
      "source": "/admin/icons/admin-512.png",
      "destination": "/icons/admin-512.png"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/admin/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/admin/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
